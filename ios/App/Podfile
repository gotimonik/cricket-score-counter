require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# Third-party pods (AppAuth, Google Mobile Ads, etc.) ship code that uses
# APIs Apple has since deprecated. We can't change their source, so hide
# their compiler warnings; warnings in our own App target still show.
inhibit_all_warnings!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CodetrixStudioCapacitorGoogleAuth', :path => '../../node_modules/@codetrix-studio/capacitor-google-auth'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

APP_DEPLOYMENT_TARGET = '15.0'

# CocoaPods' "[CP] ..." script phases declare no output files (input/output
# paths are disabled above), so Xcode warns that they run on every build.
# They really are meant to run every build, so say so explicitly.
def mark_cp_phases_always_run(native_targets)
  native_targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      next unless phase.name.to_s.start_with?('[CP]')
      next unless phase.output_paths.to_a.empty? && phase.output_file_list_paths.to_a.empty?
      phase.always_out_of_date = '1'
    end
  end
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Google Sign-In's dependencies (GTMSessionFetcher, GTMAppAuth) use
  # "quoted" #includes inside their framework headers. Newer Xcode turns
  # that into hard errors ("double-quoted include in framework header,
  # expected angle-bracketed instead" / "could not build module
  # 'GTMAppAuth'"). Switch the check off at project and target level.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Build every pod for the same minimum iOS as the app, so the linker
      # doesn't warn that pods were "built for newer iOS-simulator version".
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = APP_DEPLOYMENT_TARGET
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # Xcode's module verifier re-checks each framework's public headers
      # and reports the same quoted includes as hard errors. These are
      # third-party pods we don't publish, so don't verify them.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
    end
  end

  # e.g. "[CP] Copy XCFrameworks" in Google-Mobile-Ads-SDK and
  # GoogleUserMessagingPlatform.
  mark_cp_phases_always_run(installer.pods_project.targets)
end

# The App target's "[CP] Embed Pods Frameworks" / "[CP] Copy Pods Resources"
# phases are written during integration, after post_install, so they are
# patched here instead.
post_integrate do |installer|
  installer.aggregate_targets.map(&:user_project).compact.uniq.each do |project|
    mark_cp_phases_always_run(project.native_targets)
    # Xcode's user-script sandbox only lets build scripts read files they
    # declare as inputs. Because input/output paths are disabled above, the
    # "[CP] Embed Pods Frameworks" script can't read Pods-App-frameworks.sh
    # and the build fails with "Sandbox: bash deny file-read-data".
    project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # The App target imports the Google pods' modules, so the same
      # quoted-include check must be off here too (see post_install).
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # Capacitor's own headers (CDVWebViewProcessPoolFactory) use the
      # deprecated WKProcessPool; that warning surfaces under the App target
      # when it imports them. It's Capacitor's code, not ours.
      config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
    end
    project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
    project.save
  end
end
